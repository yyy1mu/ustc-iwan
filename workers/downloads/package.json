{
  "name": "@ustc-iwan/downloads-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run site && wrangler dev",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "build": "npm run site && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run site && wrangler deploy",
    "logs": "wrangler tail",
    "site": "node scripts/build-site.mjs",
    "test": "node --test src/*.test.ts && python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "test:runtime": "node scripts/smoke-runtime.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.17.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  }
}
